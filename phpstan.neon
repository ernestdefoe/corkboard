includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    # One process: flarum/phpstan's bootstrap installs a test forum the first
    # time it runs, and parallel workers each start that install at once on a
    # fresh checkout (CI), failing with Install\StepFailed.
    parallel:
        maximumNumberOfProcesses: 1
    level: 6
    paths:
        - extend.php
        - src
    # Page Builder's classes are only there when Page Builder is installed
    # (extend.php loads them inside Extend\Conditional).
    excludePaths:
        - src/Widget
    ignoreErrors:
        -
            message: '#Ernestdefoe\\PageBuilder\\Extend\\PageBuilderBlock#'
            path: extend.php
        # Same for ernestdefoe/projects (Projects only reaches it once its Integration is on).
        -
            message: '#ErnestDefoe\\Projects\\#'
            path: src/Projects.php
